{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embodied-evaluation.org/schema/receipt-1.json",
  "title": "Recomputation receipt (EEO-REC-1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id", "receipt_version", "issued_utc", "module", "level", "claim", "scope",
    "inputs", "derivation", "outputs", "checks", "comparability", "not_supported",
    "use_limitation", "signer", "verify"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "pattern": "^REC-[0-9]{8}-[a-z0-9][a-z0-9-]*$"
    },
    "receipt_version": { "const": "EEO-REC-1" },
    "issued_utc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "module": { "enum": ["M1", "M2", "M3", "M4"] },
    "level": { "enum": ["L1", "L2", "L3"] },
    "claim": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence: the narrowest statement this record supports."
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stratum", "population", "n_units"],
      "properties": {
        "stratum": { "type": "string", "minLength": 1 },
        "population": { "type": "string", "minLength": 1 },
        "n_units": { "type": "integer", "minimum": 0 }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "id", "bytes", "sha256"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "formula", "seed", "software", "tolerance"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "formula": { "type": "string", "minLength": 1 },
        "seed": {
          "description": "Null when the derivation is deterministic and uses no random seed.",
          "oneOf": [{ "type": "integer" }, { "type": "null" }]
        },
        "software": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "tolerance": { "type": "number", "minimum": 0 }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "rows", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "rows": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rule", "result", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "result": { "enum": ["conform", "nonconform", "undetermined"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_applied", "borrowed_from", "permitted", "note"],
      "properties": {
        "rule_applied": { "enum": ["C1", "C2", "C3", "C4"] },
        "borrowed_from": {
          "description": "Null when nothing was carried across strata. A stratum name here obliges a note explaining why it is permitted.",
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "permitted": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "not_supported": {
      "type": "array",
      "minItems": 1,
      "description": "Statements a reader might wrongly draw. At least one entry is required: every record supports less than it could appear to.",
      "items": { "type": "string", "minLength": 1 }
    },
    "use_limitation": {
      "description": "Fixed statement printed on the record itself, so no reader has to look for the non-goals in the protocol.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text_version", "en", "zh"],
      "properties": {
        "text_version": { "const": "EEO-UL-1" },
        "en": { "type": "string", "minLength": 1 },
        "zh": { "type": "string", "minLength": 1 }
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "date"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["Founder", "Maintainer"] },
        "date": { "type": "string", "format": "date" }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "expected"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "expected": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "description": "A borrowed figure must carry a note and must not be marked permitted unless the rule allows it.",
      "if": {
        "properties": { "comparability": { "properties": { "borrowed_from": { "type": "string" } } } },
        "required": ["comparability"]
      },
      "then": {
        "properties": {
          "comparability": {
            "properties": { "note": { "minLength": 1 } },
            "required": ["note"]
          }
        }
      }
    }
  ]
}
