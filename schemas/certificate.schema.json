{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://embodied-evaluation.org/schema/certificate-1.0.json",
  "title": "ReDA Claim Certificate 1.0",
  "description": "A machine-checkable statement about an existing measurement. It certifies that a named estimator, applied to a named frozen input under named assumptions, yields a stated result and a stated discernibility resolution. It does not certify the underlying measurement.",
  "type": "object",
  "required": ["schema_version", "certificate_id", "issued_at", "issuer", "claim", "estimator", "input", "assumptions", "assertions", "resolution", "verification", "certificate_hash"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "reda-cert-1.0"},
    "certificate_id": {"type": "string", "pattern": "^ReDA-C-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "issuer": {
      "type": "object",
      "required": ["name", "protocol_version"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "Embodied Evaluation Observatory"},
        "protocol_version": {"type": "string"}
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "statement", "scope", "claim_level"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "statement": {"type": "string"},
        "scope": {"type": "string", "description": "What population and what release the statement is about"},
        "claim_level": {"enum": ["established-by-us", "imported-cited", "hypothesis"], "description": "三级陈述的等级标识，禁止混用"}
      }
    },
    "estimator": {
      "type": "object",
      "required": ["id", "definition"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "enum": ["icc1_dl_fisherz", "design_effect_ratio", "two_proportion_resolution", "zero_failure_upper"]},
        "definition": {"type": "string"}
      }
    },
    "input": {
      "type": "object",
      "required": ["release", "files", "file_sha256"],
      "additionalProperties": false,
      "properties": {
        "release": {"type": "string"},
        "files": {"type": "array", "items": {"type": "string"}},
        "file_sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "anchor", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "anchor": {"type": "string", "description": "假设在协议正文中的锚点（章节），无可锚点者标 none"},
          "status": {"enum": ["anchored", "adapter", "source-implied", "none"], "description": "锚定纪律：anchored=协议正文直接写明；adapter=编码适配；source-implied=由来源数据蕴含；none=未锚定，该结论不得升级为 established"}
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "quantity", "value", "unit", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "quantity": {"type": "string"},
          "value": {},
          "interval": {"type": ["object", "null"]},
          "unit": {"type": "string"},
          "status": {"enum": ["verified", "withdrawn", "superseded"]},
          "note": {"type": "string"}
        }
      }
    },
    "resolution": {
      "type": "object",
      "required": ["delta_star", "unit", "design", "alpha", "note"],
      "additionalProperties": false,
      "properties": {
        "delta_star": {"type": "number"},
        "unit": {"type": "string"},
        "design": {
          "type": "object",
          "required": ["cells_per_model", "attempts_per_cell", "rho"],
          "additionalProperties": false,
          "properties": {
            "cells_per_model": {"type": "integer"},
            "attempts_per_cell": {"type": "integer"},
            "rho": {"type": "number"}
          }
        },
        "alpha": {"type": "number"},
        "note": {"type": "string"}
      }
    },
    "not_certified": {"type": "array", "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "required": ["command", "tolerance", "toolchain"],
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string"},
        "tolerance": {"type": "number"},
        "toolchain": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "certificate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "对除本字段外的规范化 JSON 取 sha256"}
  }
}
